{
  "name": "poker-rangeman",
  "version": "4.0.0-beta.4",
  "description": "A JavaScript library for parsing, filtering and analysing poker hand ranges: notation, dead cards, board texture, hand strength, equity and blockers",
  "main": "src/rangeManager.js",
  "type": "module",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./src/rangeManager.js"
    },
    "./core": {
      "types": "./core.d.ts",
      "default": "./src/core/index.js"
    }
  },
  "files": [
    "src/",
    "index.d.ts",
    "README.md",
    "LICENSE",
    "core.d.ts"
  ],
  "scripts": {
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js && npm run test:types",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
    "test:coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage",
    "test:jest": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:types": "tsc --noEmit --strict --target es2020 --module nodenext --moduleResolution nodenext tests/types.ts",
    "bench": "node bench/run.mjs",
    "test:browser": "node tests/browser/run.mjs"
  },
  "keywords": [
    "poker",
    "range",
    "hand",
    "evaluation",
    "texas-holdem",
    "poker-hands",
    "range-calculator",
    "poker-analysis",
    "equity",
    "blockers"
  ],
  "author": "Darragh Geoghegan",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/DarraghGeo/poker-rangeman.git"
  },
  "dependencies": {
    "poker-bitvaljs": "^1.10.0",
    "poker-extval": "6.0.0-beta.2"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "jest": "^29.7.0",
    "poker-rangeman-v3": "npm:poker-rangeman@^3.8.0",
    "typescript": "^5.9.3"
  },
  "jest": {
    "transform": {},
    "testEnvironment": "node"
  },
  "engines": {
    "node": "^20.19.0 || >=22.13.0"
  },
  "types": "index.d.ts",
  "imports": {
    "#pool-backend": {
      "node": "./src/core/backend/node.js",
      "default": "./src/core/backend/browser.js"
    }
  }
}
